{
  "if": {
    "allOf": [
      { "field": "type", "equals": "Microsoft.DBforPostgreSQL/flexibleServers" },
      {
        "anyOf": [
          { "field": "Microsoft.DBForPostgreSql/flexibleServers/authConfig.passwordAuth", "notEquals": "Disabled" },
          { "field": "Microsoft.DBForPostgreSql/flexibleServers/authConfig.activeDirectoryAuth", "notEquals": "Enabled" }
        ]
      }
    ]
  },
  "then": { "effect": "deny" }
}
