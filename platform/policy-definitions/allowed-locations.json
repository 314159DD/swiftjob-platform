{
  "if": {
    "allOf": [
      { "field": "location", "notIn": "[parameters('listOfAllowedLocations')]" },
      { "field": "location", "notEquals": "global" },
      { "field": "type", "notEquals": "Microsoft.AzureActiveDirectory/b2cDirectories" },
      {
        "not": {
          "allOf": [
            { "field": "type", "equals": "Microsoft.Web/staticSites" },
            { "field": "location", "in": "[parameters('staticSiteLocations')]" }
          ]
        }
      },
      {
        "not": {
          "allOf": [
            { "field": "type", "in": "[parameters('computeTypes')]" },
            { "field": "location", "in": "[parameters('computeLocations')]" }
          ]
        }
      }
    ]
  },
  "then": { "effect": "deny" }
}
