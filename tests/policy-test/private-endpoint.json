{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "resources": [
    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2024-05-01",
      "name": "pe-policy-test",
      "location": "germanywestcentral",
      "tags": {
        "project": "swiftjob",
        "env": "platform",
        "owner": "steven"
      },
      "properties": {
        "subnet": {
          "id": "[concat(resourceGroup().id, '/providers/Microsoft.Network/virtualNetworks/vnet-none/subnets/none')]"
        },
        "privateLinkServiceConnections": [
          {
            "name": "none",
            "properties": {
              "privateLinkServiceId": "[concat(resourceGroup().id, '/providers/Microsoft.Storage/storageAccounts/stnone')]",
              "groupIds": [
                "blob"
              ]
            }
          }
        ]
      }
    }
  ]
}
